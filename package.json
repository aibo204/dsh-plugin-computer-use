{
  "name": "@valkia/dsh-plugin-computer-use",
  "description": "Opt-in DeepSeek Harness desktop Computer Use tools over Open Computer Use MCP",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valkia/dsh-plugin-computer-use.git"
  },
  "homepage": "https://github.com/valkia/dsh-plugin-computer-use#readme",
  "bugs": {
    "url": "https://github.com/valkia/dsh-plugin-computer-use/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "computer-use",
    "mcp",
    "accessibility"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-user-approval": ">=0.0.1-rc.1 <1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "open-computer-use": "0.3.1"
  }
}
